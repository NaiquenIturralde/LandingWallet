@* ==========================================================================
   WalletIconButton — botón de solo icono.
   El nombre accesible es obligatorio: un botón sin texto visible y sin
   aria-label sería inaccesible para lectores de pantalla.
   ========================================================================== *@

<button type="@Type.ToHtmlValue()" class="@CssClass" disabled="@IsDisabled" aria-busy="@AriaBusy"
        aria-label="@AriaLabel" @onclick="HandleClick">
    @if (Loading)
    {
        @* Durante la carga el spinner reemplaza al icono: nunca se muestran ambos.
           Es decorativo porque el aria-busy del botón ya comunica el estado. *@
        <WalletSpinner Decorative="true" Size="@IconSize" />
    }
    else
    {
        <Icon Name="IconName" Size="@IconSize" Decorative="true" />
    }
</button>

@code {
    /// <summary>Icono a mostrar, siempre a través del componente <see cref="Icon"/>.</summary>
    [Parameter, EditorRequired]
    public IconName IconName { get; set; }

    /// <summary>
    /// Nombre accesible del botón. Es obligatorio: sin él, el botón no tiene
    /// forma de anunciarse a lectores de pantalla.
    /// </summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    /// <summary>Variante visual.</summary>
    [Parameter]
    public WalletButtonVariant Variant { get; set; } = WalletButtonVariant.Ghost;

    /// <summary>Tipo nativo del botón.</summary>
    [Parameter]
    public WalletButtonType Type { get; set; } = WalletButtonType.Button;

    /// <summary>Tamaño del icono en píxeles.</summary>
    [Parameter]
    public int IconSize { get; set; } = 22;

    /// <summary>Deshabilita el botón.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Estado de carga. Bloquea la interacción y expone aria-busy.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Handler del click. No se dispara si el botón está deshabilitado o cargando.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    private bool IsDisabled => Disabled || Loading;

    private string? AriaBusy => Loading ? "true" : null;

    // Un botón solo-icono sin nombre accesible es inaccesible: se detecta en
    // desarrollo en lugar de renderizar silenciosamente un botón sin nombre.
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new InvalidOperationException(
                $"{nameof(WalletIconButton)} requiere un {nameof(AriaLabel)} no vacío: " +
                "un botón de solo icono sin nombre accesible no puede anunciarse a lectores de pantalla.");
        }
    }

    private string CssClass
    {
        get
        {
            var variant = Variant switch
            {
                WalletButtonVariant.Primary => "wallet-icon-button--primary",
                WalletButtonVariant.Secondary => "wallet-icon-button--secondary",
                WalletButtonVariant.Danger => "wallet-icon-button--danger",
                _ => "wallet-icon-button--ghost",
            };

            return $"wallet-icon-button {variant}";
        }
    }

    private async Task HandleClick()
    {
        if (IsDisabled)
        {
            return;
        }

        await OnClick.InvokeAsync();
    }
}
