@namespace LandingWallet.Components.Sections

@* ==========================================================================
   Sección — Proyecto (cierre breve).

   Objetivo, contexto y enfoque del proyecto en tres puntos compactos: sin
   placeholders, sin min-height y sin espacio vacío antes del footer.
   ========================================================================== *@

<SectionShell Id="proyecto" HeadingId="proyecto-title" CssClass="project-section">
    <div class="project">

        <SectionHeading HeadingId="proyecto-title" Eyebrow="PROYECTO" Title="Más que una Wallet"
                        Description="Wallet Squad 1 integra desarrollo full-stack y analítica de datos en una experiencia financiera completa." />

        <ul class="project__points">
            <li class="project__point">
                <span class="project__name">Objetivo</span>
                <span class="project__detail">Una billetera digital real —del modelo de datos a la interfaz— con
                    cuentas, movimientos, inversiones y panel administrativo funcionando sobre la misma fuente.</span>
                </li>
                <li class="project__point">
                    <span class="project__name">Contexto</span>
                    <span class="project__detail">Proyecto académico/profesional que integra las tecnologías del stack en un
                        producto coherente de punta a punta.</span>
                    </li>
                    <li class="project__point">
                        <span class="project__name">Enfoque</span>
                        <span class="project__detail">Datos reales verificables (BigQuery + Looker Studio) y una UX fintech
                            oscura, responsive y accesible.</span>
                        </li>
                    </ul>

                </div>
            </SectionShell>
