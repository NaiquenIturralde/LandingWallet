@namespace LandingWallet.Components.Sections

@* ==========================================================================
   Sección — Proyecto (cierre).

   Objetivo, contexto, aporte, decisión de diseño y resultado del proyecto en
   cinco puntos compactos: sin placeholders, sin min-height y sin espacio
   vacío antes del footer.
   ========================================================================== *@

<SectionShell Id="proyecto" HeadingId="proyecto-title" CssClass="project-section">
    <div class="project">

        <SectionHeading HeadingId="proyecto-title" Eyebrow="PROYECTO" Title="Más que una Wallet"
                        Description="Wallet Aura fue un proyecto de equipo que integró desarrollo web, diseño de interfaces, modelado de datos y visualización de información." />

        <ul class="project__points">
            <li class="project__point">
                <span class="project__name">Objetivo</span>
                <span class="project__detail">Crear una demo de billetera digital que conectara una estructura de datos
                    con una experiencia visual clara.</span>
                </li>
                <li class="project__point">
                    <span class="project__name">Contexto</span>
                    <span class="project__detail">El proyecto se desarrolló durante la formación y utilizó un dataset creado
                        por el equipo en BigQuery con datos ficticios de prueba.</span>
                    </li>
                    <li class="project__point">
                        <span class="project__name">Alcance</span>
                        <span class="project__detail">La demo muestra cuentas, movimientos e inversiones con datos de
                            prueba; la ejecución de operaciones financieras no está habilitada.</span>
                        </li>
                        <li class="project__point">
                            <span class="project__name">Acceso</span>
                            <span class="project__detail">La demo se explora sin registro, pensada para que el público
                                conozca la experiencia en pocos segundos.</span>
                            </li>
                            <li class="project__point">
                                <span class="project__name">Estado</span>
                                <span class="project__detail">Algunas funcionalidades, como la ejecución de transferencias
                                    y determinadas vistas de consulta, forman parte de futuras etapas del proyecto.</span>
                                </li>
                            </ul>

                        </div>
                    </SectionShell>
