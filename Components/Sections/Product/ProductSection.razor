@namespace LandingWallet.Components.Sections

@* ==========================================================================
   Sección — Qué es Wallet Aura + funcionalidades de la demo.

   Explica la demo sin duplicar el Hero y SIN métricas del dashboard (los
   números viven únicamente en los dashboards). Cada funcionalidad listada
   existe hoy en la aplicación: no se presentan funciones futuras como
   terminadas.
   ========================================================================== *@

<SectionShell Id="producto" HeadingId="producto-title" CssClass="product-section">
    <div class="product">

        <SectionHeading HeadingId="producto-title" Eyebrow="QUÉ ES WALLET" Title="¿Qué es Wallet Aura?"
                        Description="Wallet Aura es una demo de billetera digital desarrollada para mostrar cómo una aplicación puede organizar cuentas, movimientos e inversiones a partir de una estructura de datos y presentarla mediante una interfaz clara." />

        <h3 class="product__subtitle">Qué permite hacer</h3>

        <ul class="product__features">
            <li class="product__feature">
                <span class="product__icon" aria-hidden="true">
                    <Icon Name="IconName.Account" Size="20" Decorative="true" />
                </span>
                <span class="product__copy">
                    <span class="product__name">Cuentas y saldos ficticios</span>
                    <span class="product__detail">Visualización de las cuentas en pesos y en dólares con su saldo, alias
                        y CBU de prueba. Cada moneda se informa por separado.</span>
                    </span>
                </li>
                <li class="product__feature">
                    <span class="product__icon" aria-hidden="true">
                        <Icon Name="IconName.Transactions" Size="20" Decorative="true" />
                    </span>
                    <span class="product__copy">
                        <span class="product__name">Movimientos de prueba</span>
                        <span class="product__detail">Consulta de los movimientos recientes con tipo, dirección e importe,
                            resueltos desde el dataset del equipo.</span>
                        </span>
                    </li>
                    <li class="product__feature">
                        <span class="product__icon" aria-hidden="true">
                            <Icon Name="IconName.TrendingUp" Size="20" Decorative="true" />
                        </span>
                        <span class="product__copy">
                            <span class="product__name">Inversiones</span>
                            <span class="product__detail">Representación de las colocaciones registradas: tipo, estado,
                                monto invertido y tasa de rendimiento.</span>
                            </span>
                        </li>
                        <li class="product__feature">
                            <span class="product__icon" aria-hidden="true">
                                <Icon Name="IconName.Dashboard" Size="20" Decorative="true" />
                            </span>
                            <span class="product__copy">
                                <span class="product__name">Panel de usuario</span>
                                <span class="product__detail">Resumen de la cuenta: saldo disponible, período, movimientos
                                    recientes y accesos rápidos a las funciones de la demo.</span>
                                </span>
                            </li>
                            <li class="product__feature">
                                <span class="product__icon" aria-hidden="true">
                                    <Icon Name="IconName.Analytics" Size="20" Decorative="true" />
                                </span>
                                <span class="product__copy">
                                    <span class="product__name">Gráficos con Looker Studio</span>
                                    <span class="product__detail">Gráficos desarrollados con Looker Studio a partir de los datos
                                        de prueba del proyecto.</span>
                                    </span>
                                </li>
                                <li class="product__feature">
                                    <span class="product__icon" aria-hidden="true">
                                        <Icon Name="IconName.Audit" Size="20" Decorative="true" />
                                    </span>
                                    <span class="product__copy">
                                        <span class="product__name">Panel de administración</span>
                                        <span class="product__detail">Indicadores del sistema, distribuciones de transacciones y
                                            datos de auditoría de la demo.</span>
                                        </span>
                                    </li>
                                    <li class="product__feature">
                                        <span class="product__icon" aria-hidden="true">
                                            <Icon Name="IconName.Menu" Size="20" Decorative="true" />
                                        </span>
                                        <span class="product__copy">
                                            <span class="product__name">Navegación responsive</span>
                                            <span class="product__detail">Interfaz adaptada a escritorio, tablet y dispositivos
                                                móviles, con accesos cómodos en cada pantalla.</span>
                                            </span>
                                        </li>
                                    </ul>

                                </div>
                            </SectionShell>
