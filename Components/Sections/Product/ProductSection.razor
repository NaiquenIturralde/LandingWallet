@namespace LandingWallet.Components.Sections

@* ==========================================================================
   Sección — Qué es Wallet + Funcionalidades REALES.

   Explica el producto sin duplicar el Hero y SIN métricas del dashboard
   (los números viven únicamente en los dashboards reales). Cada
   funcionalidad listada existe hoy en la aplicación y su ruta se indica:
   no se presentan funciones futuras como terminadas.
   ========================================================================== *@

<SectionShell Id="producto" HeadingId="producto-title" CssClass="product-section">
    <div class="product">

        <SectionHeading HeadingId="producto-title" Eyebrow="QUÉ ES WALLET" Title="¿Qué es Wallet?"
                        Description="Una aplicación financiera real para consultar cuentas, movimientos e inversiones en un solo lugar —con datos consultados directamente desde BigQuery— y un panel de administración para seguir el estado del sistema." />

        <h3 class="product__subtitle">Qué permite hacer</h3>

        <ul class="product__features">
            <li class="product__feature">
                <span class="product__icon" aria-hidden="true">
                    <Icon Name="IconName.Account" Size="20" Decorative="true" />
                </span>
                <span class="product__copy">
                    <span class="product__name">Cuentas y saldos</span>
                    <span class="product__detail">Consultá tus cuentas en pesos y en dólares con su saldo actual, alias
                        y CBU. Cada moneda se informa por separado.</span>
                    </span>
                </li>
                <li class="product__feature">
                    <span class="product__icon" aria-hidden="true">
                        <Icon Name="IconName.Transactions" Size="20" Decorative="true" />
                    </span>
                    <span class="product__copy">
                        <span class="product__name">Movimientos recientes</span>
                        <span class="product__detail">Los últimos movimientos con tipo, dirección e importe, resueltos desde
                            el origen de datos.</span>
                        </span>
                    </li>
                    <li class="product__feature">
                        <span class="product__icon" aria-hidden="true">
                            <Icon Name="IconName.TrendingUp" Size="20" Decorative="true" />
                        </span>
                        <span class="product__copy">
                            <span class="product__name">Inversiones</span>
                            <span class="product__detail">Seguimiento de las colocaciones reales: tipo, estado, monto invertido
                                y tasa de rendimiento.</span>
                            </span>
                        </li>
                        <li class="product__feature">
                            <span class="product__icon" aria-hidden="true">
                                <Icon Name="IconName.Transfer" Size="20" Decorative="true" />
                            </span>
                            <span class="product__copy">
                                <span class="product__name">Preparación de transferencias</span>
                                <span class="product__detail">Interfaz de transferencia con las cuentas de origen reales y sus
                                    validaciones. La ejecución de operaciones está en preparación y no se simula.</span>
                                </span>
                            </li>
                            <li class="product__feature">
                                <span class="product__icon" aria-hidden="true">
                                    <Icon Name="IconName.Analytics" Size="20" Decorative="true" />
                                </span>
                                <span class="product__copy">
                                    <span class="product__name">Analítica con Looker Studio</span>
                                    <span class="product__detail">Los dashboards embeben reportes reales de Looker Studio sobre la
                                        actividad financiera y del sistema.</span>
                                    </span>
                                </li>
                                <li class="product__feature">
                                    <span class="product__icon" aria-hidden="true">
                                        <Icon Name="IconName.Audit" Size="20" Decorative="true" />
                                    </span>
                                    <span class="product__copy">
                                        <span class="product__name">Administración y auditoría</span>
                                        <span class="product__detail">Panel del rol administrador con indicadores del sistema,
                                            distribuciones de transacciones y errores de auditoría.</span>
                                        </span>
                                    </li>
                                </ul>

                            </div>
                        </SectionShell>
