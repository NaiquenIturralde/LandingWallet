@namespace LandingWallet.Components.Sections

@* ==========================================================================
   Sección — Preguntas frecuentes.

   Preguntas ancladas en el relato de la demo: origen de los datos, contenido
   de los gráficos, tecnologías y alcance pendiente. Lo que la aplicación no
   puede respaldar (por ejemplo, la ejecución de transferencias) se aclara
   como fuera de alcance: nunca se presenta como terminado.
   ========================================================================== *@

<SectionShell Id="ayuda" HeadingId="ayuda-title" CssClass="faq-section">
    <div class="faq">

        <SectionHeading HeadingId="ayuda-title" Eyebrow="AYUDA" Title="Preguntas frecuentes"
                        Description="¿Necesitás ayuda? Estas son las respuestas que la propia aplicación puede respaldar hoy." />

        <div class="faq__list">
            @foreach (var entry in Entries)
            {
                <FaqItem Question="@entry.Question" Answer="@entry.Answer" />
            }
        </div>

    </div>
</SectionShell>

@code {
    /// <summary>
    /// Preguntas y respuestas de la demo: origen de los datos, gráficos,
    /// tecnologías y alcance. Ninguna respuesta presenta como terminada una
    /// función que todavía no existe.
    /// </summary>
    private static readonly IReadOnlyList<FaqEntry> Entries =
    [
        new("¿Puedo usar esta aplicación para realizar transferencias reales?",
            "No. Wallet Aura es una demo con datos ficticios. La interfaz muestra cómo podría funcionar el flujo, pero no ejecuta operaciones financieras reales."),
        new("¿Los saldos y movimientos son verdaderos?",
            "No. Son datos ficticios creados para probar y representar el funcionamiento del sistema."),
        new("¿De dónde salen los datos?",
            "El equipo creó un dataset en BigQuery y cargó datos de prueba para cuentas, movimientos, inversiones y auditoría."),
        new("¿Qué muestran los gráficos?",
            "Representan ingresos, egresos, evolución de actividad y distribución de movimientos a partir de los datos de prueba del proyecto."),
        new("¿Qué tecnologías se utilizaron?",
            "Blazor, C#, .NET, SQL, BigQuery y Looker Studio, junto con criterios de diseño UX/UI y desarrollo responsive."),
        new("¿Qué parte está pendiente?",
            "Algunas funcionalidades, como la ejecución de transferencias y determinadas vistas de consulta, forman parte de futuras etapas del proyecto."),
    ];

    /// <summary>Par pregunta/respuesta de la FAQ.</summary>
    private sealed record FaqEntry(string Question, string Answer);
}
